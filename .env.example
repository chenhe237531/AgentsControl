# ---------------------------------------------------------------------------
# 复制为 .env 后填写。真实 .env 已在 .gitignore 中，绝不提交。
# 生产（APP_ENV=prod）会在启动时强校验：JWT_SECRET 长度、GITHUB_WEBHOOK_SECRET、OWNER_OPENIDS。
# ---------------------------------------------------------------------------

APP_ENV=dev
APP_VERSION=0.1.0
LOG_LEVEL=info
API_PREFIX=/api/v1

# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://afc:afc_dev_password@localhost:5432/afc
# Alembic 用同步驱动；留空则自动从 DATABASE_URL 推导
DATABASE_URL_SYNC=
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
DB_ECHO=false

# --- 缓存 / 限流 ---
REDIS_URL=redis://localhost:6379/0

# --- 认证（单用户白名单，不开放注册）---
JWT_SECRET=dev-only-insecure-secret-change-me-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
OWNER_OPENIDS=
OWNER_EMAIL=owner@example.com

# --- 设备接入 ---
DEVICE_HMAC_WINDOW_SECONDS=300
DEVICE_OFFLINE_AFTER_SECONDS=300
DEVICE_SUSPECT_MISSED_HEARTBEATS=3

# --- 外部集成（占位，勿填真实值到此文件）---
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=
LITELLM_BASE_URL=
LANGFUSE_BASE_URL=
COS_BUCKET=

# --- 可观测 ---
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=false

# --- 前端构建期（web/.env.local 单独配置）---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
