# ---------------------------------------------------------------------------
# 复制为 .env 后填写。真实 .env 已在 .gitignore 中，绝不提交。
# 生产（APP_ENV=prod）会在启动时强校验：JWT_SECRET 长度、GITHUB_WEBHOOK_SECRET、OWNER_OPENIDS。
# ---------------------------------------------------------------------------

APP_ENV=dev
APP_VERSION=0.1.0
LOG_LEVEL=info
API_PREFIX=/api/v1

# --- 单机编排（deploy/docker-compose.yml 读取）---
# 本地默认值可直接用；生产务必改 POSTGRES_PASSWORD / 域名 / ACME_EMAIL。
POSTGRES_USER=afc
POSTGRES_PASSWORD=afc_dev_password
POSTGRES_DB=afc
# 本地用 localhost + api.localhost（Caddy 内部自签证书）；生产换成已备案域名
APP_DOMAIN=localhost
API_DOMAIN=api.localhost
ACME_EMAIL=admin@example.com
# 宿主端口：HTTP_PORT/HTTPS_PORT 给域名访问；LOCAL_HTTP_PORT 是回环排障入口
HTTP_PORT=80
HTTPS_PORT=443
LOCAL_HTTP_PORT=8080

# --- 数据库 ---
DATABASE_URL=postgresql+asyncpg://afc:afc_dev_password@localhost:5432/afc
# Alembic 用同步驱动；留空则自动从 DATABASE_URL 推导
DATABASE_URL_SYNC=
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
DB_ECHO=false

# --- 缓存 / 限流 ---
REDIS_URL=redis://localhost:6379/0

# --- 认证（单用户白名单，不开放注册）---
JWT_SECRET=dev-only-insecure-secret-change-me-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
OWNER_OPENIDS=
OWNER_EMAIL=owner@example.com

# --- 设备接入 ---
DEVICE_HMAC_WINDOW_SECONDS=300
DEVICE_OFFLINE_AFTER_SECONDS=300
DEVICE_SUSPECT_MISSED_HEARTBEATS=3

# --- 外部集成（占位，勿填真实值到此文件）---
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=
# 不填则 AI 三问不可用（返回 upstream_error: LiteLLM_BASE_URL 未配置），其余功能正常；
# 目标仍可在「目标」页直接创建。
LITELLM_BASE_URL=
LANGFUSE_BASE_URL=
COS_BUCKET=

# --- 可观测 ---
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=false

# --- 前端构建期（web/Dockerfile 的 build arg）---
# 同源相对路径：浏览器请求 <host>/api/v1/*，由 Caddy 反代到 api:8000。
# 不要把 http://localhost:8000 写进来；NEXT_PUBLIC_* 是构建期常量，改完必须 --build。
NEXT_PUBLIC_API_BASE_URL=/api/v1
