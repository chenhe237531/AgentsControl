<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.afc.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/afc-agent</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- 占位：实际安装时由 `afc-agent install --env FILE` 注入 -->
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/tmp/afc-agent.out.log</string>
    <key>StandardErrorPath</key><string>/tmp/afc-agent.err.log</string>
</dict>
</plist>